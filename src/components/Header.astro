---
import { conBase } from '../lib/rutas';
import { Icon } from 'astro-icon/components';
import { navegacionPrincipal, seccionPadre } from '../data/navegacion';
import { contacto, enlaceMembresia } from '../data/contacto';

const rutaActual = Astro.url.pathname.replace(/\/?$/, '/');
const seccionActiva = seccionPadre[rutaActual] ?? rutaActual;
// "page" en la página exacta; "true" cuando se está en una subsección (p. ej. Institucional dentro de Nosotros)
const esActual = (href: string) => (rutaActual === href ? 'page' : seccionActiva === href ? 'true' : undefined);
---

<header class="sticky top-0 z-40 border-b border-gray-200 bg-white">
  <!-- Franja tricolor -->
  <div class="flex h-1.5" aria-hidden="true">
    <span class="flex-1 bg-py-rojo"></span>
    <span class="flex-1 bg-white"></span>
    <span class="flex-1 bg-py-azul"></span>
  </div>

  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:gap-8 lg:py-4 lg:px-8">
    <a href={conBase('/')} class="flex min-w-0 items-center gap-3 no-underline" aria-label="IPPSE — Ir al inicio">
      <img src={conBase('/logo-ippse.svg')} alt="IPPSE" width="160" height="60" class="h-14 w-auto shrink-0 sm:h-16 lg:h-20" />
    </a>

    <!-- Navegación de escritorio (≥ 1024 px) -->
    <nav aria-label="Navegación principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {navegacionPrincipal.map(({ etiqueta, href }) => (
          <li>
            <a
              href={href}
              aria-current={esActual(href)}
              class:list={[
                'flex min-h-11 items-center whitespace-nowrap border-b-2 px-3 text-sm font-semibold uppercase tracking-wide no-underline',
                esActual(href)
                  ? 'border-py-rojo text-py-azul'
                  : 'border-transparent text-gray-700 hover:border-py-azul hover:text-py-azul',
              ]}
            >
              {etiqueta}
            </a>
          </li>
        ))}
        <li class="ml-3">
          <a href={enlaceMembresia} class="flex min-h-11 items-center rounded bg-py-rojo px-5 text-sm font-semibold uppercase tracking-wide whitespace-nowrap text-white no-underline hover:bg-py-rojo-oscuro hover:text-white">
            Unirse
          </a>
        </li>
      </ul>
    </nav>

    <!-- Botón del menú móvil (< 1024 px) -->
    <button
      type="button"
      class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded border border-gray-300 bg-white px-3 text-sm font-semibold text-gray-800 hover:border-py-azul hover:text-py-azul lg:hidden"
      aria-haspopup="dialog"
      aria-controls="menu-movil"
      aria-expanded="false"
      data-menu-abrir
    >
      <Icon name="lucide:menu" class="h-5 w-5" aria-hidden="true" />
      Menú
    </button>
  </div>

  <!-- Menú móvil: <dialog> nativo = foco atrapado, Escape, fondo inerte y capa superior -->
  <dialog id="menu-movil" aria-label="Menú" class="menu-movil lg:hidden" data-menu>
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
        <img src={conBase('/logo-ippse.svg')} alt="IPPSE" width="160" height="60" class="h-14 w-auto" />
        <button
          type="button"
          class="inline-flex min-h-11 items-center gap-2 rounded border border-gray-300 px-3 text-sm font-semibold text-gray-800 hover:border-py-azul hover:text-py-azul"
          data-menu-cerrar
        >
          <Icon name="lucide:x" class="h-5 w-5" aria-hidden="true" />
          Cerrar
        </button>
      </div>

      <nav aria-label="Navegación principal" class="flex-1 overflow-y-auto px-4 py-4">
        <ul class="divide-y divide-gray-100">
          {navegacionPrincipal.map(({ etiqueta, href }) => (
            <li>
              <a
                href={href}
                aria-current={esActual(href)}
                class:list={[
                  'flex min-h-14 items-center justify-between gap-4 border-l-4 px-4 font-serif text-lg font-semibold no-underline',
                  esActual(href)
                    ? 'border-py-rojo bg-py-azul-claro text-py-azul'
                    : 'border-transparent text-gray-900 hover:bg-gray-50 hover:text-py-azul',
                ]}
              >
                {etiqueta}
                <span class="text-py-rojo" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>

        <a href={enlaceMembresia} class="mt-6 flex min-h-12 items-center justify-center rounded bg-py-rojo px-5 font-semibold uppercase tracking-wide text-white no-underline hover:bg-py-rojo-oscuro hover:text-white">
          Unirse al IPPSE
        </a>
      </nav>

      <address class="border-t border-gray-200 bg-gray-50 px-6 py-4 text-sm not-italic text-gray-600">
        <p>{contacto.ciudad}</p>
        <p><a href={`mailto:${contacto.email}`}>{contacto.email}</a></p>
      </address>
    </div>
  </dialog>
</header>

<script>
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const abrir = document.querySelector<HTMLButtonElement>('[data-menu-abrir]');
  const cerrar = document.querySelector<HTMLButtonElement>('[data-menu-cerrar]');

  if (menu && abrir) {
    abrir.addEventListener('click', () => {
      menu.showModal();
      abrir.setAttribute('aria-expanded', 'true');
    });

    cerrar?.addEventListener('click', () => menu.close());

    // Tocar el fondo oscuro (fuera del panel) cierra el menú
    menu.addEventListener('click', (e) => {
      if (e.target === menu) menu.close();
    });

    // Se dispara con Escape, el botón Cerrar o el fondo; el foco vuelve solo al botón Menú
    menu.addEventListener('close', () => abrir.setAttribute('aria-expanded', 'false'));

    // Si la ventana crece a escritorio con el menú abierto, se cierra
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }
</script>
