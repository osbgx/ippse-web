---
import { alertas } from '../data/alertas';
---

{alertas.length > 0 && (
  <section aria-label="Avisos importantes" class="ticker flex items-stretch overflow-hidden border-b border-gray-200 bg-white text-sm">
    <p class="z-10 flex shrink-0 items-center bg-py-rojo px-3 py-2 text-xs font-semibold uppercase tracking-wide text-white sm:px-4 sm:text-sm">
      Última hora
    </p>
    <div class="relative flex-1 overflow-hidden">
      <div class="ticker-pista flex w-max">
        {[false, true].map((duplicado) => (
          <ul class="flex shrink-0 items-center" aria-hidden={duplicado ? 'true' : undefined}>
            {alertas.map(({ tipo, texto, href }) => (
              <li class="flex items-center whitespace-nowrap px-4 py-2 text-gray-700 sm:px-6">
                <span
                  class:list={[
                    'mr-3 rounded-sm px-1.5 py-0.5 text-xs font-bold uppercase tracking-wide',
                    tipo === 'Alerta' ? 'bg-py-rojo/10 text-py-rojo-oscuro' : 'bg-py-azul-claro text-py-azul',
                  ]}
                >{tipo}</span>
                {href ? (
                  <a href={href} tabindex={duplicado ? -1 : undefined} class="font-medium">{texto}</a>
                ) : (
                  texto
                )}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>
)}
