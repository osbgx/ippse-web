---
import { Icon } from 'astro-icon/components';
import { categorias, fechaLegible, urlVisor, type Publicacion } from '../data/publicaciones';

interface Props {
  publicacion: Publicacion;
  /** Nivel del título según el contexto de la página. */
  nivel?: 'h2' | 'h3';
}

const { publicacion, nivel: Titulo = 'h3' } = Astro.props;
const { id, titulo, fecha, categoria, autor, extracto, lectura, disponible, pdf } = publicacion;
const idTitulo = `pub-${id}`;
---

<article
  aria-labelledby={idTitulo}
  class:list={[
    'group relative flex h-full flex-col rounded border border-gray-200 border-t-4 bg-white p-5 shadow-sm sm:p-6',
    disponible
      ? 'border-t-py-azul transition-shadow focus-within:shadow-md hover:border-t-py-rojo hover:shadow-md'
      : 'border-t-gray-300',
  ]}
>
  <p class="font-serif flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm font-semibold">
    <span class="text-py-rojo">{categorias[categoria]}</span>
    <time datetime={fecha} class="text-gray-500">{fechaLegible(fecha)}</time>
    <span class="font-normal text-gray-500">{lectura} min de lectura</span>
  </p>
  <Titulo id={idTitulo} class="mt-3 text-lg font-semibold leading-snug break-words sm:text-xl">
    {disponible ? (
      // El enlace cubre toda la tarjeta mediante ::after
      <a href={urlVisor(id)} class="text-gray-900 no-underline after:absolute after:inset-0 group-hover:text-py-azul">
        {titulo}
      </a>
    ) : (
      titulo
    )}
  </Titulo>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-600">{extracto}</p>
  <p class="mt-5 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-gray-100 pt-4 text-sm">
    <span class="text-gray-500">{autor}</span>
    {disponible ? (
      <span class="flex flex-wrap items-center gap-x-4 gap-y-1">
        {pdf && (
          <a
            href={pdf}
            target="_blank"
            rel="noopener"
            class="relative z-10 inline-flex items-center gap-1.5 font-semibold text-py-rojo no-underline hover:text-py-rojo-oscuro"
          >
            <Icon name="lucide:download" class="h-4 w-4" aria-hidden="true" />
            PDF
            <span class="sr-only">del {titulo} (abre en una pestaña nueva)</span>
          </a>
        )}
        <span class="font-semibold text-py-azul" aria-hidden="true">Leer documento →</span>
      </span>
    ) : (
      <span class="inline-flex items-center gap-1.5 font-semibold text-gray-500">
        <Icon name="lucide:clock" class="h-4 w-4" aria-hidden="true" />
        Próximamente
      </span>
    )}
  </p>
</article>
