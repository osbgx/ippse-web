---
import { conBase } from '../lib/rutas';
import '../styles/global.css';
import Header from '../components/Header.astro';
import CintaAlertas from '../components/CintaAlertas.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descripcion?: string;
}

const {
  titulo,
  descripcion = 'Instituto de Profesionales Paraguayos del Sector Eléctrico (IPPSE).',
} = Astro.props;

const tituloCompleto = titulo === 'Inicio' ? 'IPPSE — Instituto de Profesionales Paraguayos del Sector Eléctrico' : `${titulo} | IPPSE`;
// ASTRO.site ya incluye el base (p. ej. https://osbgx.github.io/ippse-web), y Astro.url.pathname
// trae el path con base: juntos dan la URL canónica completa en ambos destinos.
const urlCanonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-PY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/svg+xml" href={conBase('/favicon.svg')} />
    <link rel="icon" type="image/x-icon" href={conBase('/favicon.ico')} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PY" />
    <meta name="theme-color" content="#0038a8" />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-py-azul focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>
    <Header />
    <CintaAlertas />
    <main id="contenido" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
