---
import { conBase } from '../lib/rutas';
import { Icon } from 'astro-icon/components';
import { getEntry, render } from 'astro:content';
import LayoutBase from '../layouts/LayoutBase.astro';
import EncabezadoPagina from '../components/EncabezadoPagina.astro';
import { fundacion, historia, mision, vision, valores, equipo, descripcionCorta } from '../data/institucion';
import { pdfConstitucion } from '../data/documentos';

const descripcion =
  'Historia, misión, valores y equipo del Instituto de Profesionales Paraguayos del Sector Eléctrico, ' +
  'una asociación técnica independiente al servicio del desarrollo energético nacional.';

// Documentos institucionales: se listan a partir de las secciones del Markdown
const documento = await getEntry('institucional', 'constitucion');
const documentos = documento ? (await render(documento)).headings.filter((h) => h.depth === 2) : [];
---

<LayoutBase titulo="Quiénes Somos" descripcion={descripcionCorta}>
  <EncabezadoPagina titulo="Quiénes Somos" bajada={descripcion} />

  <!-- 01 Historia y fundamentos -->
  <section aria-labelledby="historia-titulo" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1fr_20rem] lg:gap-16">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-py-rojo">01 · Historia y fundamentos</p>
        <h2 id="historia-titulo" class="mt-3 text-2xl font-bold leading-tight sm:text-3xl">{historia.titulo}</h2>
        {historia.parrafos.map((p) => <p class="mt-4 max-w-3xl leading-relaxed text-gray-700">{p}</p>)}
      </div>
      <aside class="self-start rounded border border-gray-200 border-l-4 border-l-py-azul bg-white p-6 shadow-sm" aria-label="Datos de fundación">
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Fundado el</p>
        <p class="mt-1 font-serif text-2xl font-bold text-py-azul">{fundacion}</p>
        <p class="mt-2 text-sm text-gray-600">Asunción, República del Paraguay</p>
        <a href={conBase('/institucional/#acta-de-constitucion')} class="mt-4 flex min-h-11 items-center text-sm font-semibold">Ver Acta de constitución →</a>
      </aside>
    </div>
  </section>

  <!-- 02 Misión y visión -->
  <section aria-labelledby="mision-titulo" class="border-y border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-py-rojo">02 · Misión y visión</p>
      <h2 id="mision-titulo" class="mt-3 text-2xl font-bold sm:text-3xl">Nuestro propósito y horizonte</h2>
      <dl class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded border border-gray-200 border-t-4 border-t-py-azul bg-gray-50 p-6">
          <dt class="font-serif text-xl font-semibold text-py-azul">Misión</dt>
          <dd class="mt-2 leading-relaxed text-gray-700">{mision}</dd>
        </div>
        <div class="rounded border border-gray-200 border-t-4 border-t-py-rojo bg-gray-50 p-6">
          <dt class="font-serif text-xl font-semibold text-py-azul">Visión</dt>
          <dd class="mt-2 leading-relaxed text-gray-700">{vision}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 03 Valores -->
  <section aria-labelledby="valores-titulo" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-py-rojo">03 · Valores</p>
    <h2 id="valores-titulo" class="mt-3 text-2xl font-bold sm:text-3xl">Principios que guían nuestro trabajo</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-3 sm:gap-6">
      {valores.map(({ titulo, descripcion }) => (
        <li class="rounded border border-gray-200 border-l-4 border-l-py-rojo bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold">{titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">{descripcion}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 04 Comisión directiva y equipo -->
  <section aria-labelledby="equipo-titulo" class="border-y border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-py-rojo">04 · Comisión directiva y equipo técnico</p>
      <h2 id="equipo-titulo" class="mt-3 text-2xl font-bold sm:text-3xl">Referentes del sector eléctrico</h2>
      <ol class="mt-8 grid gap-4 md:grid-cols-3 md:gap-6">
        {equipo.map(({ nombre, rol, bio }, i) => (
          <li class="flex gap-4 rounded border border-gray-200 bg-gray-50 p-6">
            <span class="font-serif text-2xl font-bold text-gray-300" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-lg font-semibold">{nombre}</h3>
              <p class="mt-1 text-sm font-semibold text-py-azul">{rol}</p>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{bio}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 05 Marco institucional -->
  <section aria-labelledby="marco-titulo" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-py-rojo">05 · Marco institucional</p>
        <h2 id="marco-titulo" class="mt-3 text-2xl font-bold sm:text-3xl">Documentos institucionales</h2>
      </div>
      <a href={conBase('/institucional/')} class="inline-flex min-h-11 items-center font-semibold">Ver todos los documentos →</a>
    </div>
    <ul class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3">
      <!-- Acta de Constitución: versión oficial en PDF -->
      <li>
        <a
          href={pdfConstitucion.href}
          target="_blank"
          rel="noopener"
          class="group flex h-full flex-col rounded border border-gray-200 border-l-4 border-l-py-rojo bg-white p-3 no-underline shadow-sm hover:bg-gray-50 sm:p-4"
        >
          <span class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-py-rojo">
            <Icon name="lucide:download" class="h-3.5 w-3.5" aria-hidden="true" />
            PDF
          </span>
          <span class="mt-1 font-serif text-base font-semibold leading-snug text-gray-900 group-hover:text-py-azul sm:text-lg">Acta de Constitución</span>
          <span class="sr-only">(abre en una pestaña nueva)</span>
        </a>
      </li>
      {documentos.map(({ slug, text }) => (
        <li>
          <a href={conBase(`/institucional/#${slug}`)} class="group flex h-full flex-col rounded border border-gray-200 border-l-4 border-l-py-azul bg-white p-3 no-underline shadow-sm hover:border-l-py-rojo sm:p-4">
            <span class="text-xs font-semibold uppercase tracking-wide text-gray-500">Documento</span>
            <span class="mt-1 font-serif text-base font-semibold leading-snug text-gray-900 group-hover:text-py-azul sm:text-lg">{text}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</LayoutBase>
