---
import { Icon } from 'astro-icon/components';
import LayoutBase from '../layouts/LayoutBase.astro';
import EncabezadoPagina from '../components/EncabezadoPagina.astro';
import TarjetaPublicacion from '../components/TarjetaPublicacion.astro';
import { publicacionesOrdenadas, urlVisor } from '../data/publicaciones';
import { canalWhatsApp } from '../data/contacto';

const descripcion =
  'Repositorio de diagnósticos, propuestas estratégicas y ensayos técnicos elaborados por el IPPSE ' +
  'para el fortalecimiento del sector eléctrico nacional.';

/** Publicaciones por página del paginado. */
const POR_PAGINA = 6;

// Datos estructurados para buscadores (schema.org)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Informes y Publicaciones del IPPSE',
  itemListElement: publicacionesOrdenadas.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Report',
      name: p.titulo,
      datePublished: p.fecha,
      abstract: p.extracto,
      author: { '@type': 'Organization', name: p.autor },
      url: new URL(urlVisor(p.id), Astro.site).href,
    },
  })),
};
---

<LayoutBase titulo="Informes y Publicaciones" descripcion={descripcion}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <EncabezadoPagina titulo="Informes y Publicaciones" bajada={descripcion} />

  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 md:py-12 lg:px-8">
    <!-- Buscador por título: mejora progresiva, sin JS se ven todas las publicaciones -->
    <form role="search" class="hidden" data-buscador-form novalidate>
      <label for="buscar-titulo" class="block text-sm font-semibold text-gray-700">Buscar por título</label>
      <div class="relative mt-2 max-w-xl">
        <Icon name="lucide:search" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" aria-hidden="true" />
        <input
          type="search"
          id="buscar-titulo"
          name="q"
          autocomplete="off"
          placeholder="Escribí palabras del título…"
          class="min-h-12 w-full rounded border border-gray-300 bg-white py-3 pl-12 pr-4 text-base text-gray-900 placeholder:text-gray-400 focus:border-py-azul focus:outline-none focus:ring-1 focus:ring-py-azul"
          data-buscador
        />
      </div>
    </form>

    <p class="mt-6 text-sm text-gray-500" aria-live="polite" data-contador>
      {publicacionesOrdenadas.length} publicaciones
    </p>

    <ul class="mt-4 grid gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3" data-lista>
      {publicacionesOrdenadas.map((publicacion) => (
        <li data-titulo={publicacion.titulo}>
          <TarjetaPublicacion publicacion={publicacion} nivel="h2" />
        </li>
      ))}
    </ul>

    <!-- Sin resultados -->
    <p class="hidden rounded border border-gray-200 bg-gray-50 p-6 text-center text-gray-600" data-sin-resultados>
      No se encontraron publicaciones con ese título.
    </p>

    <!-- Paginado -->
    <nav class="mt-8 hidden justify-center print:hidden" aria-label="Paginación de publicaciones" data-paginado>
      <ul class="flex flex-wrap items-center gap-1" data-paginado-lista></ul>
    </nav>

    <!-- Invitación al canal de WhatsApp -->
    <aside class="mt-10 rounded border border-gray-200 border-t-4 border-t-[#25D366] bg-gray-50 p-6 sm:p-8" aria-labelledby="wa-titulo">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-2xl">
          <h2 id="wa-titulo" class="flex items-center gap-2 font-serif text-xl font-semibold text-gray-900 sm:text-2xl">
            <Icon name="simple-icons:whatsapp" class="h-6 w-6 shrink-0 text-[#25D366]" aria-hidden="true" />
            Recibí los informes y participá
          </h2>
          <p class="mt-3 leading-relaxed text-gray-700">
            Sumate al canal de WhatsApp del IPPSE para recibir los informes técnicos y las novedades
            del sector eléctrico, y participar en las iniciativas de participación ciudadana.
          </p>
        </div>
        <a
          href={canalWhatsApp}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded bg-[#075E54] px-6 py-3 font-semibold text-white no-underline hover:bg-[#053f39]"
        >
          <Icon name="simple-icons:whatsapp" class="h-5 w-5 text-[#25D366]" aria-hidden="true" />
          Unirme al canal de WhatsApp
          <span class="sr-only">(abre en una pestaña nueva)</span>
        </a>
      </div>
    </aside>
  </div>

  <script type="application/json" id="pub-config" set:html={JSON.stringify({ porPagina: POR_PAGINA })} />
</LayoutBase>

<script>
  const POR_PAGINA =
    JSON.parse(document.getElementById('pub-config')?.textContent ?? '{}').porPagina ?? 6;

  const form = document.querySelector<HTMLFormElement>('[data-buscador-form]');
  const input = document.querySelector<HTMLInputElement>('[data-buscador]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-lista] > li')];
  const contador = document.querySelector<HTMLElement>('[data-contador]');
  const sinResultados = document.querySelector<HTMLElement>('[data-sin-resultados]');
  const paginado = document.querySelector<HTMLElement>('[data-paginado]');
  const paginadoLista = document.querySelector<HTMLElement>('[data-paginado-lista]');

  /** Normaliza texto: minúsculas y sin tildes, para buscar "transmision" en "Transmisión". */
  const normalizar = (texto: string) =>
    texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/\p{Diacritic}/gu, '');

  const titulos = items.map((item) => normalizar(item.dataset.titulo ?? ''));

  let termino = '';
  let pagina = 1;

  function render() {
    const coincidencias = items.filter((_, i) => titulos[i].includes(termino));
    const totalPaginas = Math.max(1, Math.ceil(coincidencias.length / POR_PAGINA));
    if (pagina > totalPaginas) pagina = totalPaginas;

    const inicio = (pagina - 1) * POR_PAGINA;
    const visibles = new Set(coincidencias.slice(inicio, inicio + POR_PAGINA));

    items.forEach((item) => (item.hidden = !visibles.has(item)));

    if (contador) {
      const n = coincidencias.length;
      contador.textContent = termino
        ? `${n} ${n === 1 ? 'publicación' : 'publicaciones'} para “${input?.value.trim()}”`
        : `${n} ${n === 1 ? 'publicación' : 'publicaciones'}`;
    }

    sinResultados?.classList.toggle('hidden', coincidencias.length > 0);

    // Paginado: solo si hay más de una página
    if (paginado && paginadoLista) {
      paginadoLista.replaceChildren();
      paginado.classList.toggle('hidden', totalPaginas <= 1);
      paginado.classList.toggle('flex', totalPaginas > 1);
      if (totalPaginas > 1) {
        const boton = (texto: string, destino: number, actual: boolean, etiqueta?: string) => {
          const li = document.createElement('li');
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = texto;
          if (etiqueta) b.setAttribute('aria-label', etiqueta);
          if (actual) b.setAttribute('aria-current', 'page');
          b.disabled = actual;
          b.className =
            'inline-flex h-11 min-w-11 items-center justify-center rounded border px-3 text-sm font-semibold ' +
            (actual
              ? 'border-py-azul bg-py-azul text-white'
              : 'border-gray-300 bg-white text-gray-700 hover:border-py-azul hover:text-py-azul');
          b.addEventListener('click', () => {
            pagina = destino;
            render();
            document.querySelector('[data-lista]')?.scrollIntoView({ block: 'start' });
          });
          li.append(b);
          return li;
        };

        paginadoLista.append(boton('‹', pagina - 1, false, 'Página anterior'));
        for (let p = 1; p <= totalPaginas; p++) {
          paginadoLista.append(boton(String(p), p, p === pagina, `Página ${p}`));
        }
        paginadoLista.append(boton('›', pagina + 1, false, 'Página siguiente'));
      }
    }
  }

  form?.classList.replace('hidden', 'block');

  input?.addEventListener('input', () => {
    termino = normalizar(input.value.trim());
    pagina = 1;
    render();
  });

  // Evita recargar la página al enviar (Enter) en un formulario de búsqueda.
  form?.addEventListener('submit', (e) => e.preventDefault());

  render();
</script>
