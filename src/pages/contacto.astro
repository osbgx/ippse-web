---
import { Icon } from 'astro-icon/components';
import LayoutBase from '../layouts/LayoutBase.astro';
import EncabezadoPagina from '../components/EncabezadoPagina.astro';
import { citaPresidente } from '../data/institucion';
import { contacto, telefonoEnlace, accionFormulario } from '../data/contacto';

const tipos = [
  { valor: 'consulta', etiqueta: 'Consulta general', placeholder: '¿En qué podemos ayudarte?', boton: 'Enviar mensaje' },
  {
    valor: 'membresia',
    etiqueta: 'Solicitud de membresía',
    placeholder: 'Contanos sobre tu trayectoria profesional y motivación para unirte al IPPSE.',
    boton: 'Enviar solicitud',
  },
];

const datos = [
  { etiqueta: 'Sede', valor: contacto.ciudad },
  { etiqueta: 'Email', valor: contacto.email, href: `mailto:${contacto.email}` },
  { etiqueta: 'Teléfono', valor: contacto.telefono, href: `tel:${telefonoEnlace}` },
];

const campo =
  'mt-1 block min-h-11 w-full rounded border border-gray-300 bg-white px-3 py-2 text-base text-gray-900 ' +
  'placeholder:text-gray-400 focus:border-py-azul focus:outline-2 focus:outline-offset-0 focus:outline-py-azul';
const etiquetaCampo = 'text-sm font-semibold text-gray-800';
---

<LayoutBase
  titulo="Contacto y Membresía"
  descripcion="Contactá al IPPSE o solicitá tu membresía como profesional del sector eléctrico paraguayo."
>
  <EncabezadoPagina titulo="Contacto y Membresía" antetitulo="Contacto / Unirse" />

  <div class="mx-auto grid grid-cols-1 max-w-7xl gap-10 px-4 py-10 sm:px-6 md:py-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:px-8">
    <!-- Cita y datos de contacto -->
    <div>
      <figure>
        <blockquote class="font-serif text-xl font-semibold leading-snug text-gray-900 sm:text-2xl">
          <p>“{citaPresidente.texto}”</p>
        </blockquote>
        <figcaption class="mt-4 text-sm text-gray-600">— {citaPresidente.autor}</figcaption>
      </figure>

      <dl class="mt-10 divide-y divide-gray-200 border-y border-gray-200">
        {datos.map(({ etiqueta, valor, href }) => (
          <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2">
            <dt class="text-xs font-semibold uppercase tracking-widest text-gray-500">{etiqueta}</dt>
            <dd class="font-medium text-gray-900">{href ? <a href={href} class="inline-flex min-h-11 items-center">{valor}</a> : valor}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Formulario -->
    <section id="formulario" aria-labelledby="formulario-titulo" class="rounded border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
      <h2 id="formulario-titulo" class="sr-only">Formulario de contacto</h2>

      <div role="status" class="mb-6 hidden rounded border-l-4 border-green-700 bg-green-50 p-4 text-green-900" data-aviso="enviado">
        Mensaje enviado. Te responderemos a la brevedad.
      </div>
      <div role="alert" class="mb-6 hidden rounded border-l-4 border-py-rojo bg-red-50 p-4 text-py-rojo-oscuro" data-aviso="error">
        No se pudo enviar el mensaje. Revisá los datos o escribinos directamente a <a href={`mailto:${contacto.email}`}>{contacto.email}</a>.
      </div>

      <form method="post" action={accionFormulario} class="formulario-contacto space-y-5" data-formulario>
        <!-- Pestañas: radios nativos (funcionan sin JS y son accesibles por teclado) -->
        <fieldset>
          <legend class="sr-only">Tipo de mensaje</legend>
          <div class="grid grid-cols-2 gap-1 rounded bg-gray-100 p-1">
            {tipos.map(({ valor, etiqueta }, i) => (
              <label class="flex min-h-11 cursor-pointer items-center justify-center rounded px-2 text-center text-sm font-semibold text-gray-600 has-checked:bg-py-azul has-checked:text-white has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-py-azul">
                <input type="radio" name="tipo" value={valor} checked={i === 0} class="sr-only" />
                {etiqueta}
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="nombre" class={etiquetaCampo}>Nombre completo <span class="text-py-rojo" aria-hidden="true">*</span></label>
          <input id="nombre" name="nombre" type="text" required autocomplete="name" maxlength="120" placeholder="Tu nombre" class={campo} />
        </div>

        <div>
          <label for="email" class={etiquetaCampo}>Email <span class="text-py-rojo" aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email" maxlength="160" placeholder="tu@email.com" class={campo} />
        </div>

        <div class="solo-membresia">
          <label for="especialidad" class={etiquetaCampo}>Especialidad / Área del sector <span class="text-py-rojo" aria-hidden="true">*</span></label>
          <input id="especialidad" name="especialidad" type="text" maxlength="160" placeholder="Ej: Ingeniería eléctrica, economía energética, derecho..." class={campo} />
        </div>

        <div>
          <label for="mensaje" class={etiquetaCampo}>Mensaje <span class="text-py-rojo" aria-hidden="true">*</span></label>
          <textarea id="mensaje" name="mensaje" required rows="5" maxlength="5000" placeholder={tipos[0].placeholder} class={campo} data-placeholders={JSON.stringify(Object.fromEntries(tipos.map((t) => [t.valor, t.placeholder])))}></textarea>
        </div>

        <!-- Trampa anti-spam: invisible para personas, los bots la completan -->
        <div class="hidden" aria-hidden="true">
          <label for="sitio_web">No completar</label>
          <input id="sitio_web" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <p class="text-xs text-gray-500"><span class="text-py-rojo" aria-hidden="true">*</span> Campos obligatorios</p>

        <button type="submit" class="flex min-h-12 w-full items-center justify-center gap-2 rounded bg-py-azul px-6 font-semibold text-white hover:bg-py-azul-oscuro sm:w-auto" data-boton-enviar>
          <span data-boton-texto>{tipos[0].boton}</span>
          <Icon name="lucide:send" class="h-4 w-4" aria-hidden="true" />
        </button>
      </form>
    </section>
  </div>
</LayoutBase>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-formulario]')!;
  const especialidad = form.querySelector<HTMLInputElement>('#especialidad')!;
  const mensaje = form.querySelector<HTMLTextAreaElement>('#mensaje')!;
  const textoBoton = form.querySelector<HTMLElement>('[data-boton-texto]')!;
  const placeholders: Record<string, string> = JSON.parse(mensaje.dataset.placeholders ?? '{}');

  const aplicarTipo = (tipo: string) => {
    const membresia = tipo === 'membresia';
    especialidad.required = membresia;
    mensaje.placeholder = placeholders[tipo] ?? '';
    textoBoton.textContent = membresia ? 'Enviar solicitud' : 'Enviar mensaje';
  };

  form.addEventListener('change', (e) => {
    const radio = e.target as HTMLInputElement;
    if (radio.name === 'tipo') aplicarTipo(radio.value);
  });

  // ?tipo=membresia (botón "Unirse") preselecciona la pestaña; ?enviado=1 / ?error=1 los pone el PHP
  const params = new URLSearchParams(location.search);
  const tipoInicial = params.get('tipo') === 'membresia' ? 'membresia' : 'consulta';
  form.querySelector<HTMLInputElement>(`input[name="tipo"][value="${tipoInicial}"]`)!.checked = true;
  aplicarTipo(tipoInicial);

  for (const aviso of ['enviado', 'error']) {
    if (params.get(aviso) === '1') document.querySelector(`[data-aviso="${aviso}"]`)?.classList.remove('hidden');
  }
</script>
