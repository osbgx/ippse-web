# Configuración Apache (cPanel) para el sitio estático del IPPSE

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # URLs del sitio anterior -> nuevas rutas (301 permanente, conserva SEO y enlaces compartidos)
  RewriteRule ^informes-publicaciones/?$ /publicaciones/ [R=301,L]

  # Rutas sin barra final -> con barra (evita contenido duplicado)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]
</IfModule>

# Caché larga para CSS, JS y fuentes (llevan hash en el nombre)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
